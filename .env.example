LLM_API_KEY=
VISION_API_KEY=
SPEECH_TO_TEXT_API_KEY=
# Ingestion (Ayesha)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
YOUTUBE_API_KEY=
# AI Gateway (Ayesha): comma-separated token:user pairs, e.g. GATEWAY_TOKENS=abc123:alice,def456:bob
GATEWAY_TOKENS=
# Cost guard (ingestion/budget.py): keys by label (python -m ingestion.cli video ... --key dev|test) and generous safety ceilings
GEMINI_API_KEY_DEV=
GEMINI_API_KEY_TEST=
GW_MAX_USD_RUN=5
GW_MAX_USD_DAY=10
GW_MAX_TOKENS_RUN=5000000
OPENAI_API_KEY= 

# Online accounts and sync (Mehak): Supabase project URL and the ANON (public) key only. Never the service_role key. See docs/supabase.md
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The app's connection to the AI Gateway (docs/gateway_client.md). Set BOTH and the app keeps no provider key: video links, answers and YouTube lookups go through the gateway.
# Leave empty in development to use the keys above directly.
GUIDEWIRE_GATEWAY_URL=
GUIDEWIRE_GATEWAY_TOKEN=
